<idea-plugin>
  <id>dev.commentcompanion</id>
  <name>Comment Companion</name>
  <version>0.1.0</version>
  <vendor>kaughara</vendor>

  <description><![CDATA[
    注释驱动的 Go 编码伴侣：在函数上方写 <code>// ai：...</code>，AI 读取注释、修改函数体，
    完成后把注释规范化成普通 Go doc comment。没有聊天窗口，交流只发生在注释里。
  ]]></description>

  <!-- 平台基础 + Go 插件 API（Go PSI）+ 限定只装载到 GoLand -->
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.go</depends>
  <depends>com.intellij.modules.goland</depends>

  <idea-version since-build="262" until-build="262.*"/>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="CommentCompanion" displayType="BALLOON"/>
    <!-- 只在设置了 -Dcommentcompanion.verifyTo 时动作，供沙盒验证脚本使用 -->
    <postStartupActivity implementation="dev.commentcompanion.plugin.VerifyStartupActivity"/>
    <!-- M1b：项目打开后启动扫描与串行 worker -->
    <postStartupActivity implementation="dev.commentcompanion.ide.CompanionBootstrap"/>
  </extensions>

  <actions>
    <action id="CommentCompanion.ScanFile"
            class="dev.commentcompanion.plugin.ScanFileAction"
            text="Comment Companion：扫描 ai：指令"
            description="扫描当前 Go 文件里的 ai：指令并显示数量">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift A"/>
    </action>
  </actions>
</idea-plugin>
